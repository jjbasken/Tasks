# REQUIRED. Generate a fresh value with:  openssl rand -base64 48
# Left empty on purpose — the server refuses to start when this is unset, shorter
# than 32 characters, or a placeholder, because anyone who knows the signing key
# can mint a token for any account (including an admin one).
JWT_SECRET=

# Set to your public domain when using Cloudflare Tunnel
CORS_ORIGIN=http://localhost:3000

# Required only when running with --profile tunnel
# Get this from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Configure → Install connector
CLOUDFLARE_TUNNEL_TOKEN=

# Optional note attachment limits, in bytes (defaults: 50 MiB per file, 2 GiB per user).
# nginx caps a single upload at 110 MiB regardless; raise client_max_body_size in
# apps/frontend/nginx.conf too if you go higher.
MAX_FILE_BYTES=
FILES_QUOTA_BYTES=

# Optional prebuilt images. CI publishes every merge to main as `latest` and
# `sha-<first 12 characters of the commit>`; pin a sha tag to hold a version.
# Forks set the prefix to their own registry namespace.
TASKS_IMAGE_PREFIX=
TASKS_TAG=
